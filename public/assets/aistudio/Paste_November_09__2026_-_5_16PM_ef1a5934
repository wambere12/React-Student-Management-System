            placeholder="School Address"
            value={form.address}
            onChange={e => setForm({
              ...form,
              address: e.target.value
            })}
          />

          <button type="submit">Register School</button>
        </form>

        {error && <p role="alert">{error}</p>}
      </section>

      <section className="content-card">
        <h2>Registered Schools ({schools.length})</h2>

        <table>
          <thead>
            <tr>
              <th>School Name</th>
              <th>School Code</th>
              <th>Email</th>
              <th>Phone</th>
            </tr>
          </thead>

          <tbody>
            {schools.map(school => (
              <tr key={school.id}>
                <td>{school.school_name}</td>
                <td>{school.school_code}</td>
                <td>{school.email}</td>
                <td>{school.phone}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    </div>
  );
}



This page is intended for the super administrator. The database policies prevent ordinary school administrators from registering schools.
