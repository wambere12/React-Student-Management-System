import { supabase } from "./supabase";

export async function getStudents() {
  return await supabase
    .from("students")
    .select("*")
    .order("created_at", { ascending: false });
}

export async function saveStudent(student, editingId) {
  if (editingId) {
    return await supabase
      .from("students")
      .update(student)
      .eq("id", editingId);
  }

  return await supabase
    .from("students")
    .insert([student]);
}

export async function removeStudent(id) {
  return await supabase
    .from("students")
    .delete()
    .eq("id", id);
}



Create src/pages/Students.jsx:

import { useEffect, useState } from "react";
import { supabase } from "../services/supabase";
import {
  getStudents,
  saveStudent,
  removeStudent
} from "../services/studentService";

const emptyForm = {
  student_id: "",
  full_name: "",
  email: "",
  gender: "",
  phone: "",
  course: "",
  class_name: ""
};

export default function Students() {
  const [students, setStudents] = useState([]);
  const [form, setForm] = useState(emptyForm);
  const [search, setSearch] = useState("");
  const [editingId, setEditingId] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  async function loadStudents() {
    const { data, error } = await getStudents();

    if (error) {
      setError(error.message);
      return;
    }

    setStudents(data || []);
  }

  useEffect(() => {
    loadStudents();
  }, []);

  function handleChange(e) {
    setForm({
      ...form,
      [e.target.name]: e.target.value
    });
  }

  async function handleSubmit(e) {
    e.preventDefault();
    setLoading(true);
    setError("");

    const { data: { user } } = await supabase.auth.getUser();

    if (!user) {
      setError("Please log in again.");
      setLoading(false);
      return;
    }

    const { data: profile, error: profileError } = await supabase
      .from("profiles")
      .select("school_id, role")
      .eq("id", user.id)
      .single();

    if (profileError || !profile) {
      setError("Administrator profile not found.");
      setLoading(false);
      return;
    }

    const studentData = { ...form };

    if (!editingId) {
      studentData.school_id =
        profile.role === "school_admin"
          ? profile.school_id
          : null;
    } else {
      delete studentData.school_id;
    }

    const { error } = await saveStudent(studentData, editingId);

    setLoading(false);

    if (error) {
      setError(error.message);
      return;
    }

    setForm(emptyForm);
    setEditingId(null);
    await loadStudents();
  }

  function editStudent(student) {
    setEditingId(student.id);

    setForm({
      student_id: student.student_id || "",
      full_name: student.full_name || "",
      email: student.email || "",
      gender: student.gender || "",
      phone: student.phone || "",
      course: student.course || "",
      class_name: student.class_name || ""
    });

    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  async function deleteStudent(id) {
    if (!window.confirm("Are you sure you want to delete this student?")) {
      return;
    }

    const { error } = await removeStudent(id);

    if (error) {
      setError(error.message);
      return;
    }

    await loadStudents();
  }

  const filtered = students.filter(student =>
    `${student.full_name} ${student.student_id} ${student.course}`
      .toLowerCase()
      .includes(search.toLowerCase())
  );

  return (
    <div>
      <h1>Student Management</h1>
      <p>Register and manage school student records.</p>

      <section className="content-card">
        <h2>{editingId ? "Update Student" : "Register Student"}</h2>

        <form onSubmit={handleSubmit} className="student-form">
          <input
            name="student_id"
            placeholder="Student ID"
            value={form.student_id}
            onChange={handleChange}
            required
          />

          <input
            name="full_name"
            placeholder="Full Name"
            value={form.full_name}
            onChange={handleChange}
            required
          />

          <input
            name="email"
            type="email"
            placeholder="Email"
            value={form.email}
            onChange={handleChange}
          />

          <select
            name="gender"
            value={form.gender}
            onChange={handleChange}
            required
          >
            <option value="">Select Gender</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
          </select>

          <input
            name="phone"
            placeholder="Phone"
            value={form.phone}
            onChange={handleChange}
          />

          <input
            name="course"
            placeholder="Course"
            value={form.course}
            onChange={handleChange}
          />

          <input
            name="class_name"
            placeholder="Class"
            value={form.class_name}
            onChange={handleChange}
          />

          <button disabled={loading}>
            {loading ? "Saving..." :
              editingId ? "Update Student" : "Register Student"}
          </button>

          {editingId && (
            <button
              type="button"
              onClick={() => {
                setEditingId(null);
                setForm(emptyForm);
              }}
            >
              Cancel
            </button>
          )}
        </form>

        {error && <p role="alert">{error}</p>}
      </section>

      <section className="content-card">
        <h2>Student Records ({filtered.length})</h2>

        <input
          placeholder="Search by name, ID or course..."
          value={search}
          onChange={e => setSearch(e.target.value)}
        />

        <div className="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Student ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Course</th>
                <th>Class</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              {filtered.map(student => (
                <tr key={student.id}>
                  <td>{student.student_id}</td>
                  <td>{student.full_name}</td>
                  <td>{student.email}</td>
                  <td>{student.course}</td>
                  <td>{student.class_name}</td>
                  <td>
                    <button onClick={() => editStudent(student)}>
                      Edit
                    </button>

                    <button onClick={() => deleteStudent(student.id)}>
                      Delete
                    </button>
                  </td>
                </tr>
              ))}

              {filtered.length === 0 && (
                <tr>
                  <td colSpan="6">No students found.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  );
}



Important: This version obtains school_id from the authenticated administrator's database profile, rather than trusting a school ID submitted by the browser. The database RLS policies enforce the school boundary.
