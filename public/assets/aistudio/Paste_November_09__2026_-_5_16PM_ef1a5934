import { useEffect, useState } from "react";
import { supabase } from "../services/supabase";

export default function Dashboard() {
  const [stats, setStats] = useState({
    students: 0,
    classes: 0,
    school: "Loading..."
  });

  useEffect(() => {
    async function loadDashboard() {
      const { data: { user } } = await supabase.auth.getUser();

      if (!user) return;

      const { data: profile } = await supabase
        .from("profiles")
        .select("school_id, role")
        .eq("id", user.id)
        .single();

      if (!profile) return;

      let studentQuery = supabase
        .from("students")
        .select("*", { count: "exact", head: true });

      let classQuery = supabase
        .from("classes")
        .select("*", { count: "exact", head: true });

      let schoolName = "All Schools";

      if (profile.role === "school_admin") {
        studentQuery = studentQuery.eq("school_id", profile.school_id);
        classQuery = classQuery.eq("school_id", profile.school_id);

        const { data: school } = await supabase
          .from("schools")
          .select("school_name")
          .eq("id", profile.school_id)
          .single();

        schoolName = school?.school_name || "My School";
      }

      const [students, classes] = await Promise.all([
        studentQuery,
        classQuery
      ]);

      setStats({
        students: students.count || 0,
        classes: classes.count || 0,
        school: schoolName
      });
    }

    loadDashboard();
  }, []);

  return (
    <div>
      <h1>Dashboard</h1>
      <p>Welcome to {stats.school}</p>

      <div className="stats-grid">
        <div className="stat-card">
          <h3>Total Students</h3>
          <h1>{stats.students}</h1>
        </div>

        <div className="stat-card">
          <h3>Total Classes</h3>
          <h1>{stats.classes}</h1>
        </div>

        <div className="stat-card">
          <h3>School</h3>
          <h2>{stats.school}</h2>
        </div>
      </div>

      <section className="content-card">
        <h2>System Overview</h2>
        <p>
          Manage your students, classes and academic records
          from one central dashboard.
        </p>
      </section>
    </div>
  );
}



